{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Black Check",
        "type": "shell",
        "command": "${config:virtualenvPath}/black . --check"
      },
      {
        "label": "Black Fix",
        "type": "shell",
        "command": "${config:virtualenvPath}/black ."
      },
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": "${config:virtualenvPath}/pip install -r requirements.txt"
      },
      {
        "label": "Build Package",
        "type": "shell",
        "command": "${config:virtualenvPath}/python setup.py sdist bdist_wheel"
      },
      {
        "label": "Build Application",
        "type": "shell",
        "options": {
          "env": {
              "MODULE_NAME": "tnscm"
          }
        },
        "command": "${config:virtualenvPath}/pyinstaller --name $MODULE_NAME $MODULE_NAME/__main__.py"
      },
      {
        "label": "Start sphinx-autobuild",
        "type": "shell",
        "options": {
            "env": {
                "PROJECT_PORT": "8061"
            }
        },
        "command": "source ${config:virtualenvPath}/activate; sphinx-autobuild ${workspaceFolder}/docs ${workspaceFolder}/docs/_build/html -a --port $PROJECT_PORT --open-browser"
      },
      {
        "label": "Upgrade pip",
        "type": "shell",
        "command": "${config:virtualenvPath}/pip install --upgrade pip"
      },
    ]
  }